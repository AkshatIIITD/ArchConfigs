#!/usr/bin/env bash
# Pick this machine's palette and generate the configs that can't read it directly.
#   ~/.config/theme/apply            list palettes, show the current one
#   ~/.config/theme/apply graphite   switch to palettes/graphite.sh
#
# Writes to ~/.local/state/theme (outside the repo):
#   palette.sh             chosen palette (read by tmux and nvim)
#   starship.toml          ~/.config/starship.toml with this palette
#   fastfetch.jsonc        ~/.config/fastfetch/config.jsonc with this accent
#   windows-terminal.json  colour scheme to paste into Windows Terminal (WSL)
set -euo pipefail

theme_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
state="$HOME/.local/state/theme"
keys=(BG SURFACE FG MUTED ACCENT WARN CRIT)

if [ $# -eq 0 ]; then
  echo "Palettes:"
  for f in "$theme_dir"/palettes/*.sh; do echo "  $(basename "$f" .sh)"; done
  [ -f "$state/palette.sh" ] && echo "Current: $(sed -n '1s/^# palette: //p' "$state/palette.sh")"
  exit 0
fi

name="$1"
src="$theme_dir/palettes/$name.sh"
[ -f "$src" ] || { echo "No palette '$name' in $theme_dir/palettes" >&2; exit 1; }

# Load and check every key before writing anything
# shellcheck source=/dev/null
. "$src"
for k in "${keys[@]}"; do
  v="THEME_$k"
  [[ "${!v:-}" =~ ^#[0-9a-fA-F]{6}$ ]] || { echo "$src: THEME_$k must be #rrggbb" >&2; exit 1; }
done

mkdir -p "$state"
{ echo "# palette: $name"; cat "$src"; } >"$state/palette.sh"

# starship: switch to a 'theme' palette and append it (TOML tables go last)
starship_src="$HOME/.config/starship.toml"
if [ -f "$starship_src" ]; then
  {
    sed "s/^palette = .*/palette = 'theme'/" "$starship_src"
    cat <<TOML

# Generated by ~/.config/theme/apply ($name)
[palettes.theme]
accent = "$THEME_ACCENT"
base = "$THEME_BG"
text = "$THEME_FG"
muted = "$THEME_MUTED"
surface = "$THEME_SURFACE"
warn = "$THEME_WARN"
crit = "$THEME_CRIT"
TOML
  } >"$state/starship.toml"
fi

# fastfetch: replace the accent on the keys/title lines
ff_src="$HOME/.config/fastfetch/config.jsonc"
if [ -f "$ff_src" ]; then
  sed -E "s/(\"(keys|title)\": *)\"#[0-9a-fA-F]{6}\"/\1\"$THEME_ACCENT\"/" \
    "$ff_src" >"$state/fastfetch.jsonc"
fi

# Windows Terminal scheme (Settings > Open JSON file > "schemes")
cat >"$state/windows-terminal.json" <<JSON
{
  "name": "$name",
  "background": "$THEME_BG",
  "foreground": "$THEME_FG",
  "cursorColor": "$THEME_ACCENT",
  "selectionBackground": "$THEME_SURFACE",
  "black": "$THEME_BG",
  "red": "$THEME_CRIT",
  "green": "$THEME_ACCENT",
  "yellow": "$THEME_WARN",
  "blue": "$THEME_ACCENT",
  "purple": "$THEME_MUTED",
  "cyan": "$THEME_ACCENT",
  "white": "$THEME_FG",
  "brightBlack": "$THEME_SURFACE",
  "brightRed": "$THEME_CRIT",
  "brightGreen": "$THEME_ACCENT",
  "brightYellow": "$THEME_WARN",
  "brightBlue": "$THEME_ACCENT",
  "brightPurple": "$THEME_MUTED",
  "brightCyan": "$THEME_ACCENT",
  "brightWhite": "$THEME_FG"
}
JSON

echo "Theme '$name' written to $state"
echo "Reload: tmux (prefix + r), open a new shell, restart nvim."

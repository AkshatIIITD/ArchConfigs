{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/KnightArtorias.art",
    "type": "auto",
  },
  // Theme accent (#00ffff, same as kitty/waybar/mako)
  "display": {
    "color": {
      "keys": "#00ffff",
      "title": "#00ffff",
    },
  },
  // Minimal set: only modules that print something on this machine
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "break",
    "colors",
  ],
}
